# Copier ce fichier en .env (non versionné) : `npm run setup:env` le fait
# automatiquement en générant des valeurs aléatoires.
# NE JAMAIS mettre de vraies valeurs sensibles dans ce fichier.

# Base SQLite locale (chemin relatif à la racine du projet).
# Pour PostgreSQL plus tard : voir README, section « Migration PostgreSQL ».
DATABASE_URL=file:./data/memoria.db

# URL publique de l'application (utilisée plus tard pour les QR codes).
APP_URL=http://localhost:3000

# Durée de validité d'une session du back-office, en heures.
SESSION_TTL_HOURS=8

# Secret servant à hacher les adresses IP (journal, anti-spam). 32+ caractères aléatoires.
IP_HASH_SECRET=

# Comptes de test créés par `npm run db:seed` (développement local uniquement).
SEED_ADMIN_NAME=Administrateur Test
SEED_ADMIN_EMAIL=admin@exemple.test
SEED_ADMIN_PASSWORD=
SEED_EMPLOYEE_NAME=Employé Test
SEED_EMPLOYEE_EMAIL=employe@exemple.test
SEED_EMPLOYEE_PASSWORD=

# Dossier de stockage des médias téléversés (hors de public/, non versionné).
MEDIA_STORAGE_DIR=./uploads

# Dossier des sauvegardes (contient des données personnelles : à protéger, non versionné).
BACKUP_DIR=./backups
